# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# RustRover
.idea/

# Added by cargo

/target

# Merge and patch leftovers. Frequent here because short-lived branches rebase
# onto a moving main.
*.orig
*.rej

# Agent worktrees live inside the repo and are not part of it. settings.json is
# shared configuration; settings.local.json is one person's machine.
/.claude/worktrees/
/.claude/settings.local.json

.DS_Store
